#!/usr/bin/env node

import fs from "node:fs";
import path from "node:path";
import process from "node:process";

import { depreport, toCsv } from "../src/index.js";
import { parseCliArgs, HELP_TEXT } from "../src/cli.js";
import { findRepoRoot, hasWorkspaces } from "../src/repoRoot.js";
import { detectPackageManager } from "../src/packageManager.js";
import { toUpdateCommand } from "../src/updateCommand.js";

let args;
try {
  args = parseCliArgs(process.argv.slice(2));
} catch (error) {
  console.error(error.message);
  process.exit(1);
}

if (args.help) {
  console.log(HELP_TEXT);
  process.exit(0);
}

async function main() {
  const outputPath = args.output ? path.resolve(args.output) : null;

  // Progress/diagnostic messages go to stderr so stdout carries only the
  // report when no --output file is given; --quiet drops them entirely
  // (errors still reach stderr).
  const log = args.quiet ? () => {} : (message) => console.error(message);
  const rows = await depreport({
    dir: args.dir,
    types: args.types,
    // null means "not given on the command line": let depreport default.
    sort: args.sort ?? undefined,
    full: args.full,
    log,
  });
  const output = renderOutput(args, rows);

  if (outputPath) {
    fs.writeFileSync(outputPath, output, "utf8");
    log(outputPath);
  } else {
    process.stdout.write(output);
  }
}

function renderOutput(args, rows) {
  switch (args.format) {
    case "json":
      return `${JSON.stringify(rows, null, 2)}\n`;
    case "package": {
      const repoRoot = findRepoRoot(path.resolve(args.dir));
      const commands = toUpdateCommand(rows, detectPackageManager(repoRoot), {
        isMonorepo: hasWorkspaces(repoRoot),
      });
      return commands.length ? `${commands.join("\n")}\n` : "";
    }
    default:
      return args.columns ? toCsv(rows, args.columns) : toCsv(rows);
  }
}

main().catch((error) => {
  console.error(error.message || error);
  process.exit(1);
});
