#!/usr/bin/env node

import process from "node:process";

import { applyTransitiveOverrides } from "../src/overrideTransitive.js";

function help() {
  return [
    "Usage: overrideTransitive [spec ...]",
    "",
    "  spec                 ({scope}/)?{package}@{rangeSpec}",
    "                       examples: left-pad@1.3.0, @types/node@^22.0.0",
    "",
    "Updates the root package.json field used for transitive pins:",
    "  yarn: resolutions",
    "  npm/pnpm/bun: overrides",
  ].join("\n");
}

const args = process.argv.slice(2);
if (args.includes("--help") || args.includes("-h")) {
  console.log(help());
  process.exit(0);
}

try {
  const result = applyTransitiveOverrides({ dir: ".", specs: args });
  console.error(
    `${result.repoRoot}/package.json: updated ${result.field} (${result.updates} entr${result.updates === 1 ? "y" : "ies"})`,
  );
} catch (error) {
  console.error(error.message || error);
  process.exit(1);
}
