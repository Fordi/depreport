{
  "name": "@fordi-org/depreport",
  "version": "1.0.2",
  "description": "Get a report on your project's dependencies",
  "license": "ISC",
  "author": "Bryan Elliott <fordiman@gmail.com>",
  "type": "module",
  "repository": "https://github.com/Fordi/depreport",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.22.2"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "depreport": "bin/depreport"
  },
  "files": [
    "src",
    "bin"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "c8": "^11.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  },
  "scripts": {
    "test": "c8 node --test",
    "validate": "eslint && prettier --check 'src/**/*.js'",
    "neaten": "eslint --fix && prettier --write 'src/**/*.js'",
    "clean": "node bin/rm.js -- coverage dist",
    "update-usage": "depreport --help | sed -i -e '/<!--usage-->/ r /dev/stdin' -e '/<!--usage-->/,/<!--\\/usage-->/ { /<!--usage-->/b; /<!--\\/usage-->/b; d; }' README.md"
  }
}
